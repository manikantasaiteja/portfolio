  <script>
    // Case Studies Data
    const caseStudies = [
      {
        title: 'project.trackr.title',
        image: 'trackr/images/trackrimagestrackr-hero.png.png',
        tags: ['tag.uxDesign', 'tag.webPlatform', 'tag.uiDesign'],
        description: 'project.trackr.desc',
        link: 'trackr/index.html'
      },
      {
        title: 'project.flyhike.title',
        image: 'flyhigh/images/flyhike-hero.png.png',
        tags: ['tag.uxResearch', 'tag.uiDesign', 'tag.travel'],
        description: 'project.flyhike.desc',
        link: 'flyhigh/index.html'
      },
      {
        title: 'project.crew.title',
        image: 'crew-campus/images/v92_35.png',
        tags: ['tag.uxDesign', 'tag.studentApp'],
        description: 'project.crew.desc',
        link: 'crew-campus/index.html'
      },
      {
        title: 'project.water.title',
        image: 'watermanagement/images/water-hero.png.jpg',
        tags: ['tag.iot', 'tag.uxDesign', 'tag.research'],
        description: 'project.water.desc',
        link: 'watermanagement/index.html'
      }
    ];

    // Generate Project Cards (duplicate for seamless loop)
    const projectsTrack = document.getElementById('projectsTrack');
    const carouselNav = document.getElementById('carouselNav');
    let currentIndex = 0;
    let isManualControl = false;
    let manualTimeout;
    
    function createProjectCard(project) {
      const card = document.createElement('article');
      card.className = 'project-card';
      
      const tagsHTML = project.tags.map(tag => `<span class="tag" data-i18n="${tag}">${tag}</span>`).join('');
      
      card.innerHTML = `
        <div class="project-img-wrap"><img src="${project.image}" alt="${project.title}" loading="lazy" /></div>
        <div class="project-body">
          <div class="project-tags">${tagsHTML}</div>
          <h3 class="project-title" data-i18n="${project.title}">${project.title}</h3>
          <p class="project-desc" data-i18n="${project.description}">${project.description}</p>
          <a href="${project.link}" class="project-link" data-i18n="projects.viewCase">View Case Study &#8594;</a>
        </div>
      `;
      
      return card;
    }
    
    // Add projects twice for seamless infinite loop
    caseStudies.forEach(project => {
      projectsTrack.appendChild(createProjectCard(project));
    });
    caseStudies.forEach(project => {
      projectsTrack.appendChild(createProjectCard(project));
    });
    
    // Update project cards when language changes
    window.addEventListener('languageChanged', () => {
      projectsTrack.innerHTML = '';
      caseStudies.forEach(project => {
        projectsTrack.appendChild(createProjectCard(project));
      });
      caseStudies.forEach(project => {
        projectsTrack.appendChild(createProjectCard(project));
      });
      if (window.globalI18n) {
        window.globalI18n.updatePage();
      }
    });

    // Generate navigation dots
    caseStudies.forEach((_, index) => {
      const dot = document.createElement('button');
      dot.className = 'carousel-dot';
      if (index === 0) dot.classList.add('active');
      dot.setAttribute('aria-label', `Go to project ${index + 1}`);
      dot.addEventListener('click', () => goToSlide(index));
      carouselNav.appendChild(dot);
    });

    // Carousel navigation functions
    function goToSlide(index) {
      currentIndex = index;
      updateCarousel();
      activateManualControl();
    }

    function updateCarousel() {
      const cardWidth = 380 + 20; // card width + gap
      const offset = -(currentIndex * cardWidth);
      projectsTrack.style.transform = `translateX(${offset}px)`;
      
      // Update active dot
      document.querySelectorAll('.carousel-dot').forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    function activateManualControl() {
      isManualControl = true;
      projectsTrack.classList.add('manual-control');
      
      clearTimeout(manualTimeout);
      manualTimeout = setTimeout(() => {
        isManualControl = false;
        projectsTrack.classList.remove('manual-control');
      }, 10000); // Resume auto-scroll after 10 seconds
    }

    // Previous/Next buttons
    document.getElementById('prevBtn').addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + caseStudies.length) % caseStudies.length;
      updateCarousel();
      activateManualControl();
    });

    document.getElementById('nextBtn').addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % caseStudies.length;
      updateCarousel();
      activateManualControl();
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        document.getElementById('prevBtn').click();
      } else if (e.key === 'ArrowRight') {
        document.getElementById('nextBtn').click();
      }
    });

    const html = document.documentElement;
    const toggle = document.getElementById('themeToggle');
    
    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); }});
    }, {threshold: 0.12});
    document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.stagger').forEach(el => obs.observe(el));

    // Nav scroll effect
    window.addEventListener('scroll', () => {
      document.querySelector('nav').classList.toggle('scrolled', window.scrollY > 40);
    }, {passive: true});
    const saved = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', saved);
    toggle.innerHTML = saved === 'dark' ? '&#9790;' : '&#9728;';
    toggle.addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      toggle.innerHTML = next === 'dark' ? '&#9790;' : '&#9728;';
    });
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('nav-links');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
    hamburger.addEventListener('keydown', e => { if(e.key==='Enter'||e.key===' ') navLinks.classList.toggle('open'); });
        projectsTrack.classList.remove('manual-control');
      }, 10000); // Resume auto-scroll after 10 seconds
    }

    // Previous/Next buttons
    document.getElementById('prevBtn').addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + caseStudies.length) % caseStudies.length;
      updateCarousel();
      activateManualControl();
    });

    document.getElementById('nextBtn').addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % caseStudies.length;
      updateCarousel();
      activateManualControl();
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        document.getElementById('prevBtn').click();
      } else if (e.key === 'ArrowRight') {
        document.getElementById('nextBtn').click();
      }
    });

    const html = document.documentElement;
    const toggle = document.getElementById('themeToggle');
    
    // Scroll reveal
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); }});
    }, {threshold: 0.12});
    document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.stagger').forEach(el => obs.observe(el));

    // Nav scroll effect
    window.addEventListener('scroll', () => {
      document.querySelector('nav').classList.toggle('scrolled', window.scrollY > 40);
    }, {passive: true});
    const saved = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', saved);
    toggle.innerHTML = saved === 'dark' ? '&#9790;' : '&#9728;';
    toggle.addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      toggle.innerHTML = next === 'dark' ? '&#9790;' : '&#9728;';
    });
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('nav-links');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
    hamburger.addEventListener('keydown', e => { if(e.key==='Enter'||e.key===' ') navLinks.classList.toggle('open'); });
    navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

    // Typing animation with i18n support
    const typingEl = document.getElementById('typing');
    let typingIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    
    function getTypingTexts() {
      const lang = globalI18n ? globalI18n.getCurrentLanguage() : 'en';
      return [
        globalI18n.t('home.typing.designer'),
        globalI18n.t('home.typing.researcher'),
        globalI18n.t('home.typing.problem')
      ];
    }
    
    let typingTexts = getTypingTexts();
    
    // Listen for language changes to update typing texts
    window.addEventListener('languageChanged', () => {
      typingTexts = getTypingTexts();
      charIndex = 0;
      isDeleting = true;
    });
    
    function type() {
      const current = typingTexts[typingIndex];
      if (isDeleting) {
        typingEl.textContent = current.substring(0, charIndex--);
        if (charIndex < 0) {
          isDeleting = false;
          typingIndex = (typingIndex + 1) % typingTexts.length;
          setTimeout(type, 500);
          return;
        }
      } else {
        typingEl.textContent = current.substring(0, charIndex++);
        if (charIndex > current.length) {
          isDeleting = true;
          setTimeout(type, 2000);
          return;
        }
      }
      setTimeout(type, isDeleting ? 50 : 100);
    }
    
    // Start typing animation after i18n is loaded
    setTimeout(() => {
      typingTexts = getTypingTexts();
      type();
    }, 500);
  </script>

  <!-- Global i18n Script -->
  <script src="js/global-i18n.js"></script>
</body>remove('open')));
    const roles = ['UI/UX Designer','UX Researcher','UI/UX Developer','Product Designer'];
    let ri=0,ci=0,del=false;
    const el = document.getElementById('typing');
    function type(){
      const cur=roles[ri];
      if(!del){el.textContent=cur.slice(0,++ci);if(ci===cur.length){del=true;setTimeout(type,1800);return;}}
      else{el.textContent=cur.slice(0,--ci);if(ci===0){del=false;ri=(ri+1)%roles.length;setTimeout(type,400);return;}}
      setTimeout(type,del?60:90);
    }
    type();
    document.querySelectorAll('a[href^="#"]').forEach(a=>{
      a.addEventListener('click',e=>{const t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}});
    });
  </script>

  <!-- Stars canvas -->
  <canvas id="stars" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;opacity:0;transition:opacity 1s ease;"></canvas>
  <script>
    const canvas = document.getElementById('stars');
    const ctx = canvas.getContext('2d');
    let stars = [];
    function resize(){ canvas.width=window.innerWidth; canvas.height=window.innerHeight; }
    function initStars(){
      stars=[];
      const n=Math.floor((canvas.width*canvas.height)/5000);
      for(let i=0;i<n;i++) stars.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height,r:Math.random()*1.3+0.2,a:Math.random(),s:Math.random()*0.008+0.003,d:Math.random()>0.5?1:-1});
    }
    // Shooting stars
    let shooters = [];
    function spawnShooter(){
      shooters.push({
        x: Math.random()*canvas.width*0.8,
        y: Math.random()*canvas.height*0.4,
        len: Math.random()*120+60,
        speed: Math.random()*8+6,
        angle: Math.PI/4 + (Math.random()-0.5)*0.3,
        alpha: 1,
        width: Math.random()*1.5+0.5
      });
    }
    setInterval(()=>{ if(document.documentElement.getAttribute("data-theme")!=="light") spawnShooter(); }, 2200);

    function draw(){
      ctx.clearRect(0,0,canvas.width,canvas.height);
      // Twinkling stars
      stars.forEach(s=>{
        s.a+=s.s*s.d; if(s.a>=1||s.a<=0) s.d*=-1;
        ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
        ctx.fillStyle=`rgba(255,255,255,${s.a})`; ctx.fill();
      });
      // Shooting stars
      shooters = shooters.filter(s=>s.alpha>0);
      shooters.forEach(s=>{
        const tx = s.x + Math.cos(s.angle)*s.len;
        const ty = s.y + Math.sin(s.angle)*s.len;
        const grad = ctx.createLinearGradient(s.x,s.y,tx,ty);
        grad.addColorStop(0,`rgba(255,255,255,0)`);
        grad.addColorStop(0.3,`rgba(255,255,255,${s.alpha*0.6})`);
        grad.addColorStop(1,`rgba(255,255,255,${s.alpha})`);
        ctx.beginPath();
        ctx.moveTo(s.x,s.y);
        ctx.lineTo(tx,ty);
        ctx.strokeStyle=grad;
        ctx.lineWidth=s.width;
        ctx.stroke();
        // Bright head dot
        ctx.beginPath();
        ctx.arc(tx,ty,s.width*1.2,0,Math.PI*2);
        ctx.fillStyle=`rgba(255,255,255,${s.alpha})`;
        ctx.fill();
        s.x += Math.cos(s.angle)*s.speed;
        s.y += Math.sin(s.angle)*s.speed;
        s.alpha -= 0.018;
      });
      requestAnimationFrame(draw);
    }
    function updateVisibility(){ canvas.style.opacity=document.documentElement.getAttribute('data-theme')!=='light'?'1':'0'; }
    resize(); initStars(); draw(); updateVisibility();
    window.addEventListener('resize',()=>{resize();initStars();},{passive:true});
    new MutationObserver(updateVisibility).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
  </script>
</body>
</html>
