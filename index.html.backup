            <div class="skill-item"><span class="skill-dot"></span><span data-i18n="skills.figma">Figma</span></div>
            <div class="skill-item"><span class="skill-dot"></span><span data-i18n="skills.wireframing">Wireframing</span></div>
            <div class="skill-item"><span class="skill-dot"></span><span data-i18n="skills.prototyping">Prototyping</span></div>
